% TITLE PAGE (1st Page)
\defbeamertemplate*{title page}{hpi}[1][]
{
	\raggedleft
	\vspace{-26mm}
	%
	\usebeamerfont{title}\usebeamercolor[fg]{title}
	\raggedright
	
	{\hspace{26mm}\includegraphics[height=8mm]{logos/acm-logo}}
	\vspace{-10mm}
	
	\raggedleft
	\includegraphics[height=4.7mm]{logos/vinci-logo}~
	\inserttitle\par
	%
	\vspace{2mm}
	%
	\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}
	\ifx\insertsubtitle\empty
	% do nothing
	\else
    	\smallskip\insertsubtitle\enspace{}|\enspace{}%\par
	\fi
	%
	\usebeamerfont{author}\usebeamercolor[fg]{author}
	\ifx\insertauthor\empty
	% do nothing
	\else
		%\smallskip
		\textbf{\insertauthor}\par
	\fi
	%
	\usebeamerfont{institute}\usebeamercolor[fg]{institute}
	\ifx\insertinstitute\empty
		% do nothing
	\else
		\smallskip\insertinstitute\par
	\fi
}


% FRAME TITLE (Header)
\defbeamertemplate*{frametitle}{hpi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, ht=8mm, dp=1mm, wd=\paperwidth]{frametitle}
		\usebeamerfont{frametitle}\insertframetitle{}
	\end{beamercolorbox}
	\nointerlineskip
	\vspace{-16mm}
	\begin{beamercolorbox}[right, rightskip=8mm, ht=16mm, dp=1mm, wd=\paperwidth]{}
	    \includegraphics[height=5mm]{logos/uni-logo-cmyk}
	    \hspace{2mm}
	    \includegraphics[height=5mm]{logos/hpi-logo-cmyk}
	    \hspace{2mm}
	    \includegraphics[height=5mm]{logos/eurovis}
	\end{beamercolorbox}
	\vspace{-2mm}
}


% FOOT LINE (Footer)
\defbeamertemplate*{footline}{cgi}
{
	\begin{beamercolorbox}[left, leftskip=8mm, rightskip=8mm, dp=2mm, wd=\paperwidth]{footline}
		\insertpagenumber \quad \insertshorttitle 
		\hfill \insertsubtitle %\insertsubtitle~\ifx\insertsectionhead\empty\else\slash~\insertsectionhead\fi
		\hfill \insertauthor
	\end{beamercolorbox}%
}

